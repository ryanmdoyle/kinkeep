# Copy to .env for local development. .env is git-ignored; never commit real values.

# Supabase (Project Settings → API). Leave empty to run without accounts.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The database the dev server's Hyperdrive binding connects to. Wrangler needs
# a password in it, even for a local database.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:5432/wares

# Where `npm run db:migrate` applies migrations: Supabase's direct connection or
# session pooler (not the transaction pooler), or your local database.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/wares

# Optional: a throwaway database for `npm run test:db`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wares_test

# Don't send Wrangler usage data.
WRANGLER_SEND_METRICS=false
